Zephyr external architecture support, CONFIG_ARCH_EXTERNAL.

Required by the ChibiOS bindings until an equivalent change is available
upstream. Generated against the Zephyr main branch at a915b2f12675
(v4.5.0-rc2), apply it from the Zephyr tree with:

  git apply <ChibiOS>/os/various/zephyr_bindings/patches/zephyr-arch-external.patch

- arch/Kconfig: CONFIG_ARCH_EXTERNAL, selected by an architecture provided
  through ARCH_ROOT, it also enables the flash size and base address
  options.
- include/zephyr/arch/{cpu,arch_inlines,exception}.h: dispatch to
  <zephyr/arch/external/...> headers.
- include/zephyr/toolchain/{common,gcc}.h,
  include/zephyr/linker/linker-tool-gcc.h: instruction set dependent
  definitions for external architectures.
- CMakeLists.txt, lib/heap/CMakeLists.txt: the arch/common headers are
  located in the Zephyr tree, not in the architecture root.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c759db57407..339e65972dc 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1047,7 +1047,7 @@ zephyr_constants_library(
   NAME offsets
   SOURCE ${ARCH_DIR}/${ARCH}/core/offsets/offsets.c
   INCLUDES ${ARCH_DIR}/${ARCH}/include
-  INCLUDES ${ARCH_DIR}/common/include
+  INCLUDES ${ZEPHYR_BASE}/arch/common/include
   DEPENDS heap_constants
 )
 set(OFFSETS_LIB offsets)
diff --git a/arch/Kconfig b/arch/Kconfig
index 61979daa8d7..7b3b70bf522 100644
--- a/arch/Kconfig
+++ b/arch/Kconfig
@@ -249,6 +249,18 @@ config RX
 	help
 	  Renesas RX architecture
 
+config ARCH_EXTERNAL
+	bool
+	select ARCH_IS_SET
+	help
+	  Selected by an architecture provided outside of the Zephyr tree,
+	  through ARCH_ROOT, instead of one of the architecture symbols above.
+	  The architecture provides its public headers as
+	  <zephyr/arch/external/arch.h>, <zephyr/arch/external/arch_inlines.h>
+	  and <zephyr/arch/external/exception.h>. Toolchain definitions that
+	  depend on the instruction set are selected using the compiler
+	  predefined macros.
+
 config ARCH_IS_SET
 	bool
 	help
@@ -342,7 +354,8 @@ config XIP
 	  option disabled.
 
 
-if ARC || ARM || ARM64 || X86 || RISCV || RX || OPENRISC || ARCH_POSIX || HEXAGON || TRICORE
+if ARC || ARM || ARM64 || X86 || RISCV || RX || OPENRISC || ARCH_POSIX || HEXAGON || TRICORE || \
+   ARCH_EXTERNAL
 
 # Workaround for not being able to have commas in macro arguments
 DT_CHOSEN_Z_FLASH := zephyr,flash
@@ -365,7 +378,8 @@ config FLASH_BASE_ADDRESS
 	  normally set by the board's defconfig file and the user should generally
 	  avoid modifying it via the menu configuration.
 
-endif # ARM || ARM64 || ARC || X86 || RISCV || RX || OPENRISC || ARCH_POSIX || HEXAGON || TRICORE
+endif # ARM || ARM64 || ARC || X86 || RISCV || RX || OPENRISC || ARCH_POSIX || HEXAGON || TRICORE ||
+      # ARCH_EXTERNAL
 
